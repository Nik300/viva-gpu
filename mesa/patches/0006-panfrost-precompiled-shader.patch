diff --git a/src/panfrost/compiler/pan_isa_hooks.h b/src/panfrost/compiler/pan_isa_hooks.h
new file mode 100644
index 0000000..6430511
--- /dev/null
+++ b/src/panfrost/compiler/pan_isa_hooks.h
@@ -0,0 +1,56 @@
+/*
+ * Viva: precompiled shaders. An embedding driver that compiles its shaders to
+ * Valhall machine code itself (Viva's AIR -> ISA compiler) hands Gallium a
+ * "shell" nir_shader (stage and I/O info, no code) and these hooks supply the
+ * binary, the shader info and the vertex varying layout instead of the NIR
+ * compiler. A shader the hooks do not own is compiled by Mesa as usual.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef PAN_ISA_HOOKS_H
+#define PAN_ISA_HOOKS_H
+
+#include "util/u_dynarray.h"
+#include "pan_compiler.h"
+
+struct panfrost_sysvals;
+
+struct pan_isa_key {
+   mesa_shader_stage stage;
+   uint64_t gpu_id;
+   /* Vertex varying layout (vertex shaders: the one built by create_layout;
+    * fragment shaders: the linked vertex shader's, or NULL if unknown). */
+   const struct pan_varying_layout *varying_layout;
+   uint32_t vs_noperspective_varyings;
+   uint32_t fs_nr_cbufs_for_fragcolor;
+   uint32_t fs_sprite_coord_enable;
+   uint32_t fs_clip_plane_enable;
+   bool fs_line_smooth;
+   unsigned req_local_mem;
+};
+
+struct pan_isa_hooks {
+   /* Whether this (shell) shader is compiled by the hooks. */
+   bool (*owns)(const nir_shader *nir);
+   /* At CSO creation: the vertex shader's varying layout, and the fragment
+    * shader's noperspective varyings (bit i = VARYING_SLOT_VAR0 + i). */
+   void (*create_layout)(const nir_shader *nir, uint64_t gpu_id,
+                         struct pan_varying_layout *vs_layout,
+                         uint32_t *fs_noperspective);
+   /* Compiles a variant. Returns NULL with binary/info/sysvals filled, or a
+    * nir_shader (ralloc'd, owned by the caller) to compile with Mesa instead. */
+   nir_shader *(*compile)(const nir_shader *nir, const struct pan_isa_key *key,
+                          struct util_dynarray *binary,
+                          struct pan_shader_info *info,
+                          struct panfrost_sysvals *sysvals);
+};
+
+/* Set once by the embedding driver; NULL = no precompiled shaders. */
+extern const struct pan_isa_hooks *pan_isa_hooks;
+
+static inline bool
+pan_isa_owns(const nir_shader *nir)
+{
+   return pan_isa_hooks && nir && pan_isa_hooks->owns(nir);
+}
+
+#endif
