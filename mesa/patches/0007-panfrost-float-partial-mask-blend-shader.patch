Viva: Valhall fixed-function blending of float render targets with a partial colour mask writes the wrong channels (Settings > Battery bars): use a blend shader (VMG_PAN_FLOAT_MASK_FF=1 keeps fixed function).
diff --git a/src/gallium/drivers/panfrost/pan_context.c b/src/gallium/drivers/panfrost/pan_context.c
index f8425d4..0ec7ca2 100644
--- a/src/gallium/drivers/panfrost/pan_context.c
+++ b/src/gallium/drivers/panfrost/pan_context.c
@@ -173,6 +173,22 @@ panfrost_get_blend(struct panfrost_batch *batch, unsigned rti)
    bool fixed_function = is_float ? info.fixed_function_float
                                   : info.fixed_function;
 
+   /* Viva: on Valhall (Mali-G57) fixed-function blending of a float render
+    * target with a partial colour mask writes the wrong channels (RG16F with
+    * mask G stores the G output into R, ADD gives NaN): blend shader instead.
+    * VMG_PAN_FLOAT_MASK_FF=1 keeps fixed function. */
+   static int float_mask_ff = -1;
+   if (float_mask_ff < 0) {
+      const char *e = getenv("VMG_PAN_FLOAT_MASK_FF");
+      float_mask_ff = e && *e && *e != '0';
+   }
+   if (fixed_function && is_float && !float_mask_ff) {
+      unsigned comp = util_format_colormask(util_format_description(fmt));
+      unsigned mask = blend->pan.rts[rti].equation.color_mask;
+      if (mask && (mask & comp) != comp)
+         fixed_function = false;
+   }
+
    /* Use fixed-function if the equation permits, the format is blendable,
     * and no more than one unique constant is accessed */
    if (fixed_function && dev->blendable_formats[fmt].internal &&
