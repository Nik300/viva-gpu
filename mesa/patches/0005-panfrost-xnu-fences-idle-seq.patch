XNU: Panfrost fences in one IOKit call (pooled syncobj + transfer instead of emulated sync files), and
panfrost_bo_wait without WAIT_BO when the BO's last submit is known complete (submit sequence numbers).
diff --git a/src/gallium/drivers/panfrost/pan_bo.c b/src/gallium/drivers/panfrost/pan_bo.c
--- a/src/gallium/drivers/panfrost/pan_bo.c
+++ b/src/gallium/drivers/panfrost/pan_bo.c
@@ -155,17 +155,46 @@
          return true;
    }
 
+#ifdef __APPLE__
+   /* The last submit using this BO is complete: idle (BOs shared with other
+    * processes may have their jobs too, they still ask the kernel). */
+   if (!(bo->flags & PAN_BO_SHARED) && bo->dev->xnu_idle_seq &&
+       bo->xnu_seq <= p_atomic_read(&bo->dev->xnu_done_seq)) {
+      bo->gpu_access = 0;
+      return true;
+   }
+#endif
+
    if (pan_kmod_bo_wait(bo->kmod_bo, timeout_ns, !wait_readers)) {
       /* Set gpu_access to 0 so that the next call to bo_wait()
        * doesn't have to call the WAIT_BO ioctl.
        */
       bo->gpu_access = 0;
+#ifdef __APPLE__
+      /* Its last job is complete, and so is every earlier one. */
+      if (wait_readers)
+         panfrost_xnu_seq_done(bo->dev, bo->xnu_seq);
+#endif
       return true;
    }
 
    return false;
 }
 
+#ifdef __APPLE__
+void
+panfrost_xnu_seq_done(struct panfrost_device *dev, uint64_t seq)
+{
+   uint64_t cur = p_atomic_read(&dev->xnu_done_seq);
+   while (cur < seq) {
+      uint64_t prev = p_atomic_cmpxchg(&dev->xnu_done_seq, cur, seq);
+      if (prev == cur)
+         break;
+      cur = prev;
+   }
+}
+#endif
